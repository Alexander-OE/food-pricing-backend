NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/food_price_forecast"
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:5000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@foodforecast.ng
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=NitHub Admin

# Model: "local" uses the built-in forecaster, "remote" calls MODEL_SERVER_URL
MODEL_PROVIDER=local
MODEL_SERVER_URL=http://localhost:8000
MODEL_TIMEOUT_MS=15000

# Data source: "mock" reads from ml-data/, "nbs" is reserved for the real NBS feed later
DATA_SOURCE=mock

# Chatbot (Google Gemini). If LLM_API_KEY is empty, the fallback responder is used.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024

ENABLE_CRON=true
