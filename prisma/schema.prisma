generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Commodity {
  id            Int                @id @default(autoincrement())
  name          String
  slug          String             @unique
  category      CommodityCategory
  unit          String
  description   String
  imageUrl      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  events        AnalyticsEvent[]
  conversations ChatConversation[]
  feedback      Feedback[]
  predictions   Prediction[]
  prices        PriceRecord[]
}

model PriceRecord {
  id          Int         @id @default(autoincrement())
  commodityId Int
  period      DateTime    @db.Date
  price       Decimal     @db.Decimal(12, 2)
  source      PriceSource @default(MOCK)
  createdAt   DateTime    @default(now())
  commodity   Commodity   @relation(fields: [commodityId], references: [id], onDelete: Cascade)

  @@unique([commodityId, period])
  @@index([period])
}

model Prediction {
  id             Int                 @id @default(autoincrement())
  commodityId    Int
  basePeriod     DateTime            @db.Date
  targetPeriod   DateTime            @db.Date
  currentPrice   Decimal             @db.Decimal(12, 2)
  predictedPrice Decimal             @db.Decimal(12, 2)
  lowerBound     Decimal             @db.Decimal(12, 2)
  upperBound     Decimal             @db.Decimal(12, 2)
  percentChange  Float
  direction      Direction
  confidence     Float
  factors        Json
  explanation    String
  modelVersion   String
  status         PredictionStatus    @default(ACTIVE)
  createdAt      DateTime            @default(now())
  commodity      Commodity           @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  accuracy       PredictionAccuracy?

  @@unique([commodityId, targetPeriod])
  @@index([targetPeriod])
}

model PredictionAccuracy {
  id            Int        @id @default(autoincrement())
  predictionId  Int        @unique
  actualPrice   Decimal    @db.Decimal(12, 2)
  absoluteError Decimal    @db.Decimal(12, 2)
  percentError  Float
  directionHit  Boolean
  evaluatedAt   DateTime   @default(now())
  prediction    Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

model MacroIndicator {
  id        Int          @id @default(autoincrement())
  key       IndicatorKey
  period    DateTime     @db.Date
  value     Float
  createdAt DateTime     @default(now())

  @@unique([key, period])
}

model DataRefreshLog {
  id               Int           @id @default(autoincrement())
  type             RefreshType
  status           RefreshStatus
  trigger          String        @default("cron")
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  recordsProcessed Int           @default(0)
  dataPeriod       DateTime?     @db.Date
  errorMessage     String?

  @@index([type, startedAt])
}

model VisitorSession {
  id            String             @id
  firstSeenAt   DateTime           @default(now())
  lastSeenAt    DateTime           @default(now())
  userAgent     String?            @db.VarChar(512)
  events        AnalyticsEvent[]
  conversations ChatConversation[]
  feedback      Feedback[]
}

model AnalyticsEvent {
  id          Int            @id @default(autoincrement())
  sessionId   String
  type        EventType
  path        String         @db.VarChar(255)
  commodityId Int?
  metadata    Json?
  createdAt   DateTime       @default(now())
  commodity   Commodity?     @relation(fields: [commodityId], references: [id])
  session     VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([commodityId])
}

model ChatConversation {
  id            String         @id @default(uuid())
  sessionId     String
  commodityId   Int
  messageCount  Int            @default(0)
  startedAt     DateTime       @default(now())
  lastMessageAt DateTime       @default(now())
  commodity     Commodity      @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  session       VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([startedAt])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId String
  role           ChatRole
  content        String
  latencyMs      Int?
  usedFallback   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Feedback {
  id          Int              @id @default(autoincrement())
  sessionId   String?
  name        String?
  email       String?
  category    FeedbackCategory @default(GENERAL)
  message     String
  commodityId Int?
  status      FeedbackStatus   @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  commodity   Commodity?       @relation(fields: [commodityId], references: [id])
  session     VisitorSession?  @relation(fields: [sessionId], references: [id])

  @@index([status, createdAt])
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

enum CommodityCategory {
  GRAINS
  LEGUMES
  TUBERS
  VEGETABLES
  FRUITS
  PROTEIN
  OILS
  OTHERS
}

enum PriceSource {
  NBS
  MOCK
}

enum Direction {
  UP
  DOWN
  STABLE
}

enum PredictionStatus {
  ACTIVE
  SUPERSEDED
}

enum IndicatorKey {
  USD_NGN
  DIESEL_PRICE
  PETROL_PRICE
  HEADLINE_INFLATION
  FOOD_INFLATION
  RAINFALL_INDEX
  SUPPLY_INDEX
}

enum RefreshType {
  NBS_PRICES
  MACRO_FEATURES
  PREDICTIONS
  ACCURACY
}

enum RefreshStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum EventType {
  PAGE_VIEW
  COMMODITY_VIEW
  SEARCH
  CHAT_OPEN
}

enum ChatRole {
  USER
  ASSISTANT
}

enum FeedbackCategory {
  GENERAL
  BUG
  PREDICTION_ACCURACY
  FEATURE_REQUEST
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}
